# File uploads go to Cloudinary, not Firebase Storage (Firebase now
# requires the paid Blaze plan to manage Storage). Free tier, no card
# needed: cloudinary.com -> dashboard for cloud name, Settings -> Upload
# -> Upload presets -> add one with Signing Mode set to "Unsigned".
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
